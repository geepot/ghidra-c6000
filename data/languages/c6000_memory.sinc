MemRegN: "*--" ^ BaseReg ^ "[" ^ OffReg ^ "]" is mode=0xc & offr & BaseReg & OffReg & scbit=1 { local a:4 = BaseReg - (OffReg << 3); export a; }
MemRegN: "*++" ^ BaseReg ^ "[" ^ OffReg ^ "]" is mode=0xd & offr & BaseReg & OffReg & scbit=1 { local a:4 = BaseReg + (OffReg << 3); export a; }
MemRegN: "*" ^ BaseReg ^ "--[" ^ OffReg ^ "]" is mode=0xe & offr & BaseReg & OffReg & scbit=1 { local a:4 = BaseReg - (OffReg << 3); export a; }
MemRegN: "*" ^ BaseReg ^ "++[" ^ OffReg ^ "]" is mode=0xf & offr & BaseReg & OffReg & scbit=1 { local a:4 = BaseReg + (OffReg << 3); export a; }

MemLongB: "*+B14[" ^ UCst15 ^ "]" is i7=0 & ucst15 & UCst15 { local a:4 = B14 + UCst15; export a; }
MemLongB: "*+B15[" ^ UCst15 ^ "]" is i7=1 & ucst15 & UCst15 { local a:4 = B15 + UCst15; export a; }

MemLongH: "*+B14[" ^ UCst15 ^ "]" is i7=0 & ucst15 & UCst15 { local a:4 = B14 + (UCst15 << 1); export a; }
MemLongH: "*+B15[" ^ UCst15 ^ "]" is i7=1 & ucst15 & UCst15 { local a:4 = B15 + (UCst15 << 1); export a; }

MemLongW: "*+B14[" ^ UCst15 ^ "]" is i7=0 & ucst15 & UCst15 { local a:4 = B14 + (UCst15 << 2); export a; }
MemLongW: "*+B15[" ^ UCst15 ^ "]" is i7=1 & ucst15 & UCst15 { local a:4 = B15 + (UCst15 << 2); export a; }
