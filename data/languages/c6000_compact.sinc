RA1110: cq_1110_b0 is cq_1110_b0 & q_s=1 & c_rs=0 { export cq_1110_b0; }
RA1110: cq_1110_a1 is cq_1110_a1 & q_s=0 & c_rs=1 { export cq_1110_a1; }
RA1110: cq_1110_b1 is cq_1110_b1 & q_s=1 & c_rs=1 { export cq_1110_b1; }

RA4: cq_4_a0 is cq_4_a0 & q_s=0 & c_rs=0 { export cq_4_a0; }
RA4: cq_4_b0 is cq_4_b0 & q_s=1 & c_rs=0 { export cq_4_b0; }
