# ---------------------------------------------------------------------------
# Branch targets for the compact S-unit branch forms (Figures F-17..F-21).
#
# Compact fetch packets scale the displacement by one bit, not two:
# SPRUFE8B BNOP execution block, 'if instruction is within compact
# instruction fetch packet':  PFC = PCE1 + (se(scst12) << 1), where PCE1 =
# inst_start & 0xFFFFFFE0 is the first instruction of the containing fetch
# packet.  The compact forms use the same rule with their own displacement
# widths (Figures F-17/F-18/F-20/F-21 carry scst7 or ucst8, Figure F-19
# carries scst10).
# ---------------------------------------------------------------------------

CTgt7: reloc is cq_scst7 [ reloc = (inst_start & 0xffffffe0) + (cq_scst7 << 1); ]
  { export *[const]:4 reloc; }

CTgt8: reloc is cq_ucst8 [ reloc = (inst_start & 0xffffffe0) + (cq_ucst8 << 1); ]
  { export *[const]:4 reloc; }

CTgt10: reloc is cq_scst10 [ reloc = (inst_start & 0xffffffe0) + (cq_scst10 << 1); ]
  { export *[const]:4 reloc; }

