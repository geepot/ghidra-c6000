RT710Pair: "A13:A12" is q_pair710=12 & q_t=0 { export A13_A12; }
RT710Pair: "A15:A14" is q_pair710=14 & q_t=0 { export A15_A14; }
RT710Pair: "B1:B0" is q_pair710=0 & q_t=1 { export B1_B0; }
RT710Pair: "B3:B2" is q_pair710=2 & q_t=1 { export B3_B2; }
