RT710: cq_710_a is cq_710_a & q_t=0 { export cq_710_a; }
RT710: cq_710_b is cq_710_b & q_t=1 { export cq_710_b; }

RT710Pair: "A1:A0" is q_pair710=0 & q_t=0 { export A1_A0; }
RT710Pair: "A3:A2" is q_pair710=2 & q_t=0 { export A3_A2; }
