#  TMS320C6000 16-bit compact instruction definitions.
#
#  Part of the ghidra-c6000 processor extension, Apache License 2.0.
#  Written independently from the public Texas Instruments documentation;
#  every encoding and semantic rule is traceable to a figure, table or
#  section of
#
#      SPRUFE8B - TMS320C674x CPU and Instruction Set Reference Guide
#                 (literature number SPRUFE8B, July 2010)
#
#  The 16-bit opcodes are mapped in appendices C.4 (D), D.4 (L), E.4 (M),
#  F.4 (S), G.3 (D/L/S) and H.4 (no unit).  Parameters that the 16-bit
#  opcode cannot express (register-set base, LD/ST data sizes, saturation
#  and the S-unit branch mode) come from the compact fetch-packet header
#  word described in section 3.10 and are supplied through the context
#  register by the packet analyzer.
#
#  LENGTH: every constructor here consumes exactly the insn16 token, i.e.
#  two bytes.  No constructor references insn32.
#
#  Register-base scheme: compact register fields are 3 bits and index
#  within the register set selected by the header RS bit (context c_rs):
#  low = A0-A7 / B0-B7, high = A16-A23 / B16-B23.  The opcode side bit
#  (q_s for arithmetic, q_t for LD/ST data) selects the A or B file.  Since
#  SLEIGH allows only one register list per field, each slot is declared
#  once per (file, set) pair in c6000.sinc (_a0/_b0/_a1/_b1) and the small
#  sub-tables below select the right one from q_s/q_t and c_rs.

#  Conventions used below:
#
#  * c_dsz is the header DSZ field packed as
#      (DSZ[18] << 2) | (DSZ[17] << 1) | DSZ[16],
#    exactly as SPRUFE8B Table 3-15 indexes it (C6000PacketContext writes
#    it as (header >>> 16) & 7).  Table 3-15 selects the primary and
#    secondary LD/ST data size from it.
#  * A bracketed compact offset is scaled by the access size, as for the
#    32-bit addressing modes (SPRUFE8B section 3.9.3): <<0 byte, <<1
#    halfword, <<2 word, <<3 doubleword.
#  * Figure C-12 Dinc ("*ptr[ucst2]++") is a post-increment: the access
#    uses ptr and ptr is then advanced by the scaled offset.  Figure C-14
#    Ddec ("*--ptr[ucst2]") is a pre-decrement: ptr is advanced first and
#    the access uses the new ptr.  Figure C-21 Dpp pairs "*B15--[ucst2]"
#    (post-decrement) with "*++B15[ucst2]" (pre-increment).
#  * Doubleword (DW/NDW) forms name a register pair and transfer all 64 bits.

#  This file is generated by tools/gen_compact.py; edit the generator.

# ---------------------------------------------------------------------------
# Functional-unit suffixes.  In a compact instruction the opcode side bit
# (bit 0, q_s) selects both the register file and the unit side, exactly as
# the s bit does for 32-bit instructions (SPRUFE8B Table C-2).
# ---------------------------------------------------------------------------

CUnitS: ".S1" is q_s=0 { }
CUnitS: ".S2" is q_s=1 { }

CUnitL: ".L1" is q_s=0 { }
CUnitL: ".L2" is q_s=1 { }

CUnitM: ".M1" is q_s=0 { }
CUnitM: ".M2" is q_s=1 { }

CUnitD: ".D1" is q_s=0 { }
CUnitD: ".D2" is q_s=1 { }

# Figure G-1..G-4 carry an explicit 2-bit unit field: 00 = .L, 01 = .S,
# 10 = .D (Figure G-4 unit selection table).
CUnitLSD: ".L1" is q_unit=0 & q_s=0 { }
CUnitLSD: ".L2" is q_unit=0 & q_s=1 { }
CUnitLSD: ".S1" is q_unit=1 & q_s=0 { }
CUnitLSD: ".S2" is q_unit=1 & q_s=1 { }
CUnitLSD: ".D1" is q_unit=2 & q_s=0 { }
CUnitLSD: ".D2" is q_unit=2 & q_s=1 { }

# ---------------------------------------------------------------------------
# Register operands.  RA/ RB are two independent symbols over the same
# field so that a constructor can print both src2 and dst for the
# two-address forms.
# ---------------------------------------------------------------------------

RA15: cq_1513_a0 is cq_1513_a0 & q_s=0 & c_rs=0 { export cq_1513_a0; }
RA15: cq_1513_b0 is cq_1513_b0 & q_s=1 & c_rs=0 { export cq_1513_b0; }
RA15: cq_1513_a1 is cq_1513_a1 & q_s=0 & c_rs=1 { export cq_1513_a1; }
RA15: cq_1513_b1 is cq_1513_b1 & q_s=1 & c_rs=1 { export cq_1513_b1; }

RB15: cq_1513_a0 is cq_1513_a0 & q_s=0 & c_rs=0 { export cq_1513_a0; }
RB15: cq_1513_b0 is cq_1513_b0 & q_s=1 & c_rs=0 { export cq_1513_b0; }
RB15: cq_1513_a1 is cq_1513_a1 & q_s=0 & c_rs=1 { export cq_1513_a1; }
RB15: cq_1513_b1 is cq_1513_b1 & q_s=1 & c_rs=1 { export cq_1513_b1; }

RA97: cq_97_a0 is cq_97_a0 & q_s=0 & c_rs=0 { export cq_97_a0; }
RA97: cq_97_b0 is cq_97_b0 & q_s=1 & c_rs=0 { export cq_97_b0; }
