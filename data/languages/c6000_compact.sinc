RT710Pair: "B15:B14" is q_pair710=14 & q_t=1 { export B15_B14; }

RB710: cq_710b_b0 is cq_710b_b0 { export cq_710b_b0; }

# Accumulator (A0/B0) and link register (A3/B3) named by the s bit.
CAcc: cq_acc is cq_acc { export cq_acc; }

CRet: cq_ret is cq_ret { export cq_ret; }

# Predicate prefixes for the predicated compact forms (Figures F-20/F-21
# and G-3).  A display-only table must start the display, hence the table.
CPred20: "[A0] " is q_s=0 & j4=0 { }
CPred20: "[!A0] " is q_s=0 & j4=1 { }
CPred20: "[B0] " is q_s=1 & j4=0 { }
CPred20: "[!B0] " is q_s=1 & j4=1 { }

CPredCC: "[A0] " is j15=0 & j14=0 { }
CPredCC: "[!A0] " is j15=0 & j14=1 { }
CPredCC: "[B0] " is j15=1 & j14=0 { }
CPredCC: "[!B0] " is j15=1 & j14=1 { }

# ---------------------------------------------------------------------------
# Immediate operands.  Compact immediate fields are scattered across the
# opcode, so each one is composed here.
# ---------------------------------------------------------------------------

Cucst4: Cucst4v is j11 & q_r3 [ Cucst4v = (j11 << 3) | q_r3; ] { export *[const]:4 Cucst4v; }

Cucst2: Cucst2v is q_uc2 [ Cucst2v = q_uc2 + 1; ] { export *[const]:4 Cucst2v; }

Cucst2pp: Cucst2ppv is q_uc2 [ Cucst2ppv = q_uc2 + 1; ] { export *[const]:4 Cucst2ppv; }

Cucst5stk: Cucst5stkv is cq_u21 & q_r3b [ Cucst5stkv = (cq_u21 << 3) | q_r3b; ] { export *[const]:4 Cucst5stkv; }

Cucst5d: Cucst5dv is cq_uc43 & q_r3 [ Cucst5dv = (cq_uc43 << 3) | q_r3; ] { export *[const]:4 Cucst5dv; }

Cucst5p: Cucst5pv is cq_uc98 & q_r3 [ Cucst5pv = (cq_uc98 << 3) | q_r3; ] { export *[const]:4 Cucst5pv; }

Cucst5f23: Cucst5f23v is cq_uc43 & q_r3 [ Cucst5f23v = (cq_uc43 << 3) | q_r3; ] { export *[const]:4 Cucst5f23v; }

Cucst8f24: Cucst8f24v is cq_uc65 & j10 & cq_uc43 & q_r3 [ Cucst8f24v = (cq_uc65 << 5) | (j10 << 7) | (cq_uc43 << 3) | q_r3; ] { export *[const]:4 Cucst8f24v; }

Cucst3d9: q_r3 is q_r3 { export *[const]:4 q_r3; }

Cucst1f: q_uc2 is q_uc2 { export *[const]:4 q_uc2; }

CN3: q_r3 is q_r3 { export *[const]:4 q_r3; }

Cii: Ciiv is cq_ii3 & q_r3b [ Ciiv = ((cq_ii3 << 3) | q_r3b) + 1; ] { export *[const]:4 Ciiv; }

Cspk: Cspkv is cq_spk43 & q_r3b & j0 [ Cspkv = (cq_spk43 << 3) | q_r3b | (j0 << 5); ] { export *[const]:4 Cspkv; }

Cmask: Cmaskv is j15 & j14 & j9 & j8 & j7 & j0 [ Cmaskv = (j15 << 5) | (j14 << 4) | (j9 << 3) | (j8 << 2) | (j7 << 1) | j0; ] { export *[const]:4 Cmaskv; }

# Figure D-5 constant translation (the opcode is sign-magnitude with 0 -> 8).
CimmL3i: CimmL3iv is j11=0 & q_r3=0 [ CimmL3iv = 8; ] { export *[const]:4 CimmL3iv; }
CimmL3i: CimmL3iv is j11=0 & q_r3=1 [ CimmL3iv = 1; ] { export *[const]:4 CimmL3iv; }
