RX97: cq_97_a0 is cq_97_a0 & q_s=0 & q_t=0 & c_rs=0 { export cq_97_a0; }
RX97: cq_97_b0 is cq_97_b0 & q_s=0 & q_t=1 & c_rs=0 { export cq_97_b0; }
RX97: cq_97_b0 is cq_97_b0 & q_s=1 & q_t=0 & c_rs=0 { export cq_97_b0; }
RX97: cq_97_a0 is cq_97_a0 & q_s=1 & q_t=1 & c_rs=0 { export cq_97_a0; }
RX97: cq_97_a1 is cq_97_a1 & q_s=0 & q_t=0 & c_rs=1 { export cq_97_a1; }
RX97: cq_97_b1 is cq_97_b1 & q_s=0 & q_t=1 & c_rs=1 { export cq_97_b1; }
RX97: cq_97_b1 is cq_97_b1 & q_s=1 & q_t=0 & c_rs=1 { export cq_97_b1; }
RX97: cq_97_a1 is cq_97_a1 & q_s=1 & q_t=1 & c_rs=1 { export cq_97_a1; }

RT64: cq_64_a0 is cq_64_a0 & q_t=0 & c_rs=0 { export cq_64_a0; }
RT64: cq_64_b0 is cq_64_b0 & q_t=1 & c_rs=0 { export cq_64_b0; }
RT64: cq_64_a1 is cq_64_a1 & q_t=0 & c_rs=1 { export cq_64_a1; }
RT64: cq_64_b1 is cq_64_b1 & q_t=1 & c_rs=1 { export cq_64_b1; }

RT65Pair: "A1:A0" is q_r2b=0 & q_t=0 & c_rs=0 { export A1_A0; }
RT65Pair: "A3:A2" is q_r2b=1 & q_t=0 & c_rs=0 { export A3_A2; }
RT65Pair: "A5:A4" is q_r2b=2 & q_t=0 & c_rs=0 { export A5_A4; }
