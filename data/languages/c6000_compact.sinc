# Figure F-23 cst3 -> ucst5 translation (000 encodes 16, 111 encodes 8).
CimmS3i: CimmS3iv is q_r3=0 [ CimmS3iv = 16; ] { export *[const]:4 CimmS3iv; }
CimmS3i: CimmS3iv is q_r3=1 [ CimmS3iv = 1; ] { export *[const]:4 CimmS3iv; }
