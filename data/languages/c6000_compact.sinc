# ---------------------------------------------------------------------------
# Figure C-16. Dstk - SPRUFE8B appendix C.4.  ptr is B15 and s is fixed to 1
# (so the unit is always .D2); the 5-bit offset is scaled by the word size.
# ---------------------------------------------------------------------------

:STW^CUnitD^" *B15["^Cucst5stk^"], "^RT64 is c_is16=1 & CUnitD & j15=1 & j11=1 & j10=1 & j2=1 & j1=0 & q_s=1 & q_ldst=0 & RT64 & Cucst5stk { *[ram]:4 (B15 + (Cucst5stk << 2)) = RT64; }
:LDW^CUnitD^" *B15["^Cucst5stk^"], "^RT64 is c_is16=1 & CUnitD & j15=1 & j11=1 & j10=1 & j2=1 & j1=0 & q_s=1 & q_ldst=1 & RT64 & Cucst5stk { RT64 = *[ram]:4 (B15 + (Cucst5stk << 2)); }

# ---------------------------------------------------------------------------
# Figure C-17. Dx2op - SPRUFE8B appendix C.4.
# ---------------------------------------------------------------------------

:ADD^CUnitD RA15, RX97, RB15 is c_is16=1 & CUnitD & j10=0 & j6=0 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j11=0 & RA15 & RX97 & RB15 { RB15 = RA15 + RX97; }
:SUB^CUnitD RA15, RX97, RB15 is c_is16=1 & CUnitD & j10=0 & j6=0 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j11=1 & RA15 & RX97 & RB15 { RB15 = RA15 - RX97; }

# ---------------------------------------------------------------------------
# Figure C-18. Dx5 - SPRUFE8B appendix C.4.  src2 is B15; ADDAW shifts the
# 5-bit constant left by two (word addressing mode).
# ---------------------------------------------------------------------------

:ADDAW^CUnitD^" B15, "^Cucst5d^", "^RA97 is c_is16=1 & CUnitD & j10=1 & j6=0 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & RA97 & Cucst5d { RA97 = B15 + (Cucst5d << 2); }

# ---------------------------------------------------------------------------
# Figure C-19. Dx5p - SPRUFE8B appendix C.4.  src2 = dst = B15.
# ---------------------------------------------------------------------------

:ADDAW^CUnitD^" B15, "^Cucst5p^", B15" is c_is16=1 & CUnitD & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j7=0 & Cucst5p { B15 = B15 + (Cucst5p << 2); }
:SUBAW^CUnitD^" B15, "^Cucst5p^", B15" is c_is16=1 & CUnitD & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j7=1 & Cucst5p { B15 = B15 - (Cucst5p << 2); }

# ---------------------------------------------------------------------------
# Figure C-20. Dx1 - SPRUFE8B appendix C.4.  op = 010, 100 and 110 are
# reserved by the figure; op = 000/001/101/111 are the LSDx1 forms of
# Figure G-4 and are decoded there.
# ---------------------------------------------------------------------------

:SUB^CUnitD RA97, 1, RB97 is c_is16=1 & CUnitD & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j15=0 & j14=1 & j13=1 & RA97 & RB97 { RB97 = RA97 - 1; }

# ---------------------------------------------------------------------------
# Figure C-21. Dpp - SPRUFE8B appendix C.4.  ptr is B15, the header RS bit
# is ignored and src/dst is a 4-bit register number from A0-A15/B0-B15
# selected by t (SPRUFE8B Figure C-21 notes 1-4).
# ---------------------------------------------------------------------------

:STW^CUnitD " " RT710^", "^"*B15--["^Cucst2pp^"]" is c_is16=1 & CUnitD & j11=0 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j0=1 & j15=0 & j14=0 & RT710 & Cucst2pp { *[ram]:4 B15 = RT710; B15 = B15 - (Cucst2pp << 2); }
:LDW^CUnitD " " "*++B15["^Cucst2pp^"]"^", "^RT710 is c_is16=1 & CUnitD & j11=0 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j0=1 & j15=0 & j14=1 & RT710 & Cucst2pp { B15 = B15 + (Cucst2pp << 2); RT710 = *[ram]:4 B15; }
:STDW^CUnitD " " RT710Pair^", "^"*B15--["^Cucst2pp^"]" is c_is16=1 & CUnitD & j11=0 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j0=1 & j15=1 & j14=0 & RT710Pair & Cucst2pp { *[ram]:8 B15 = RT710Pair; B15 = B15 - (Cucst2pp << 3); }
:LDDW^CUnitD " " "*++B15["^Cucst2pp^"]"^", "^RT710Pair is c_is16=1 & CUnitD & j11=0 & j6=1 & j5=1 & j4=1 & j3=0 & j2=1 & j1=1 & j0=1 & j15=1 & j14=1 & RT710Pair & Cucst2pp { B15 = B15 + (Cucst2pp << 3); RT710Pair = *[ram]:8 B15; }

# ---------------------------------------------------------------------------
# Figure D-4. L3 - SPRUFE8B appendix D.4.
# ---------------------------------------------------------------------------

:ADD^CUnitL RA15, RX97, RA64 is c_is16=1 & CUnitL & j10=0 & j3=0 & j2=0 & j1=0 & j11=0 & c_sat=0 & RA15 & RX97 & RA64 { RA64 = RA15 + RX97; }
:SUB^CUnitL RA15, RX97, RA64 is c_is16=1 & CUnitL & j10=0 & j3=0 & j2=0 & j1=0 & j11=1 & c_sat=0 & RA15 & RX97 & RA64 { RA64 = RA15 - RX97; }
:SADD^CUnitL RA15, RX97, RA64 is c_is16=1 & CUnitL & j10=0 & j3=0 & j2=0 & j1=0 & j11=0 & c_sat=1 & RA15 & RX97 & RA64 { c6000_sem_sadd32(RA15, RX97, RA64); }
:SSUB^CUnitL RA15, RX97, RA64 is c_is16=1 & CUnitL & j10=0 & j3=0 & j2=0 & j1=0 & j11=1 & c_sat=1 & RA15 & RX97 & RA64 { c6000_sem_ssub32(RA15, RX97, RA64); }

# ---------------------------------------------------------------------------
# Figure D-5. L3i - SPRUFE8B appendix D.4.
# ---------------------------------------------------------------------------

:ADD^CUnitL CimmL3i, RX97, RA64 is c_is16=1 & CUnitL & j10=1 & j3=0 & j2=0 & j1=0 & CimmL3i & RX97 & RA64 { RA64 = RX97 + CimmL3i; }

# ---------------------------------------------------------------------------
# Figure D-6. Ltbd - SPRUFE8B appendix D.4.  The figure leaves its fields
# blank and no instruction description in SPRUFE8B references it, so no
# constructor is emitted.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Figure D-7. L2c - SPRUFE8B appendix D.4.  dst is a single bit selecting
# A0/A1 or B0/B1 (note under the figure).
# ---------------------------------------------------------------------------

:AND^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=0 & j6=0 & j5=0 & RA15 & RX97 & RA4 { RA4 = RA15 & RX97; }
:OR^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=0 & j6=0 & j5=1 & RA15 & RX97 & RA4 { RA4 = RA15 | RX97; }
:XOR^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=0 & j6=1 & j5=0 & RA15 & RX97 & RA4 { RA4 = RA15 ^ RX97; }
:CMPEQ^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=0 & j6=1 & j5=1 & RA15 & RX97 & RA4 { RA4 = zext(RA15 == RX97); }
:CMPLT^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=1 & j6=0 & j5=0 & RA15 & RX97 & RA4 { RA4 = zext(RA15 s< RX97); }
:CMPGT^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=1 & j6=0 & j5=1 & RA15 & RX97 & RA4 { RA4 = zext(RA15 s> RX97); }
:CMPLTU^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=1 & j6=1 & j5=0 & RA15 & RX97 & RA4 { RA4 = zext(RA15 < RX97); }
:CMPGTU^CUnitL RA15, RX97, RA4 is c_is16=1 & CUnitL & j10=1 & j3=1 & j2=0 & j1=0 & j11=1 & j6=1 & j5=1 & RA15 & RX97 & RA4 { RA4 = zext(RA15 > RX97); }

# ---------------------------------------------------------------------------
# Figure D-8. Lx5 - SPRUFE8B appendix D.4.
# ---------------------------------------------------------------------------

:MVK^CUnitL CimmLx5, RA97 is c_is16=1 & CUnitL & j10=1 & j6=0 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & CimmLx5 & RA97 { RA97 = CimmLx5; }

# ---------------------------------------------------------------------------
# Figure D-9. Lx3c - SPRUFE8B appendix D.4.
# ---------------------------------------------------------------------------

:CMPEQ^CUnitL Cucst3d9, RA97, RA4 is c_is16=1 & CUnitL & j12=0 & j10=0 & j6=0 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & Cucst3d9 & RA97 & RA4 { RA4 = zext(Cucst3d9 == RA97); }

# ---------------------------------------------------------------------------
# Figure D-10. Lx1c - SPRUFE8B appendix D.4.
# ---------------------------------------------------------------------------

:CMPLT^CUnitL Cucst1f, RA97, RA4 is c_is16=1 & CUnitL & j12=1 & j10=0 & j6=0 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j15=0 & j14=0 & Cucst1f & RA97 & RA4 { RA4 = zext(Cucst1f s< RA97); }
:CMPGT^CUnitL Cucst1f, RA97, RA4 is c_is16=1 & CUnitL & j12=1 & j10=0 & j6=0 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j15=0 & j14=1 & Cucst1f & RA97 & RA4 { RA4 = zext(Cucst1f s> RA97); }
:CMPLTU^CUnitL Cucst1f, RA97, RA4 is c_is16=1 & CUnitL & j12=1 & j10=0 & j6=0 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j15=1 & j14=0 & Cucst1f & RA97 & RA4 { RA4 = zext(Cucst1f < RA97); }
:CMPGTU^CUnitL Cucst1f, RA97, RA4 is c_is16=1 & CUnitL & j12=1 & j10=0 & j6=0 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j15=1 & j14=1 & Cucst1f & RA97 & RA4 { RA4 = zext(Cucst1f > RA97); }

# ---------------------------------------------------------------------------
# Figure D-11. Lx1 - SPRUFE8B appendix D.4.  op = 100 and 110 are reserved;
# op = 000/001/101/111 are LSDx1 (Figure G-4).
# ---------------------------------------------------------------------------

:SUB^CUnitL^" 0, "^RA97^", "^RB97 is c_is16=1 & CUnitL & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j15=0 & j14=1 & j13=0 & RA97 & RB97 { RB97 = 0 - RA97; }
:ADD^CUnitL^" -1, "^RA97^", "^RB97 is c_is16=1 & CUnitL & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j15=0 & j14=1 & j13=1 & RA97 & RB97 { RB97 = RA97 - 1; }

# ---------------------------------------------------------------------------
# Figure E-5. M3 - SPRUFE8B appendix E.4.  dst is an even register; with
# RS = 1 it is A16/A18/A20/A22 or B16/B18/B20/B22 (figure note).
# ---------------------------------------------------------------------------

:MPY^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=0 & j5=0 & c_sat=0 & RA15 & RX97 & RA1110 { local a:4 = (RA15 << 16) s>> 16; local b:4 = (RX97 << 16) s>> 16; RA1110 = a * b; }
:MPYH^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=0 & j5=1 & c_sat=0 & RA15 & RX97 & RA1110 { RA1110 = (RA15 s>> 16) * (RX97 s>> 16); }
:MPYLH^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=1 & j5=0 & c_sat=0 & RA15 & RX97 & RA1110 { local a:4 = (RA15 << 16) s>> 16; RA1110 = a * (RX97 s>> 16); }
:MPYHL^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=1 & j5=1 & c_sat=0 & RA15 & RX97 & RA1110 { local b:4 = (RX97 << 16) s>> 16; RA1110 = (RA15 s>> 16) * b; }
:SMPY^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=0 & j5=0 & c_sat=1 & RA15 & RX97 & RA1110 { local a:4 = (RA15 << 16) s>> 16; local b:4 = (RX97 << 16) s>> 16; c6000_sem_smpy16(a, b, RA1110); }
:SMPYH^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=0 & j5=1 & c_sat=1 & RA15 & RX97 & RA1110 { local a:4 = RA15 s>> 16; local b:4 = RX97 s>> 16; c6000_sem_smpy16(a, b, RA1110); }
:SMPYLH^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=1 & j5=0 & c_sat=1 & RA15 & RX97 & RA1110 { local a:4 = (RA15 << 16) s>> 16; local b:4 = RX97 s>> 16; c6000_sem_smpy16(a, b, RA1110); }
:SMPYHL^CUnitM RA15, RX97, RA1110 is c_is16=1 & CUnitM & j4=1 & j3=1 & j2=1 & j1=1 & j6=1 & j5=1 & c_sat=1 & RA15 & RX97 & RA1110 { local a:4 = RA15 s>> 16; local b:4 = (RX97 << 16) s>> 16; c6000_sem_smpy16(a, b, RA1110); }

# ---------------------------------------------------------------------------
# Figures F-17/F-18. Sbs7 / Sbu8 - SPRUFE8B appendix F.4.  BR = 1 decodes
# the S unit as branches; the target uses the compact <<1 displacement
# scale (see the CTgt tables above).
# ---------------------------------------------------------------------------

:BNOP^CUnitS CTgt7, CN3 is c_is16=1 & CUnitS & j5=0 & j4=0 & j3=1 & j2=0 & j1=1 & c_br=1 & CTgt7 & CN3 { goto CTgt7; }
:BNOP^CUnitS CTgt8, 5 is c_is16=1 & CUnitS & j15=1 & j14=1 & j5=0 & j4=0 & j3=1 & j2=0 & j1=1 & c_br=1 & CTgt8 { goto CTgt8; }

# ---------------------------------------------------------------------------
# Figure F-19. Scs10 (CALLP) - SPRUFE8B appendix F.4.  The return address
# goes to A3 or B3 as selected by s (figure note 'NextPC > B3, A3').
# ---------------------------------------------------------------------------

:CALLP^CUnitS CTgt10, CRet is c_is16=1 & CUnitS & j5=0 & j4=1 & j3=1 & j2=0 & j1=1 & c_br=1 & CTgt10 & CRet { CRet = inst_start + 24; call CTgt10; }

# ---------------------------------------------------------------------------
# Figures F-20/F-21. Sbs7c / Sbu8c - SPRUFE8B appendix F.4.  Predicated
# BNOP; the predicate register is [A0]/[B0] as selected by s and the test
# is inverted when z = 1.
# ---------------------------------------------------------------------------

:CPred20^"BNOP"^CUnitS CTgt7, CN3 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=0 & j4=0 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt7 & CN3 { if (A0 != 0) goto CTgt7; }
:CPred20^"BNOP"^CUnitS CTgt8, 5 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=0 & j4=0 & j15=1 & j14=1 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt8 { if (A0 != 0) goto CTgt8; }
:CPred20^"BNOP"^CUnitS CTgt7, CN3 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=1 & j4=0 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt7 & CN3 { if (B0 != 0) goto CTgt7; }
:CPred20^"BNOP"^CUnitS CTgt8, 5 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=1 & j4=0 & j15=1 & j14=1 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt8 { if (B0 != 0) goto CTgt8; }
:CPred20^"BNOP"^CUnitS CTgt7, CN3 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=0 & j4=1 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt7 & CN3 { if (A0 == 0) goto CTgt7; }
:CPred20^"BNOP"^CUnitS CTgt8, 5 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=0 & j4=1 & j15=1 & j14=1 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt8 { if (A0 == 0) goto CTgt8; }
:CPred20^"BNOP"^CUnitS CTgt7, CN3 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=1 & j4=1 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt7 & CN3 { if (B0 == 0) goto CTgt7; }
:CPred20^"BNOP"^CUnitS CTgt8, 5 is c_is16=1 & CPred20 & CUnitS & c_br=1 & q_s=1 & j4=1 & j15=1 & j14=1 & j5=1 & j3=1 & j2=0 & j1=1 & CTgt8 { if (B0 == 0) goto CTgt8; }

# ---------------------------------------------------------------------------
# Figure F-22. S3 - SPRUFE8B appendix F.4.  BR must be 0 for the
# non-branch S-unit opcodes (Table 3-14).
# ---------------------------------------------------------------------------

:ADD^CUnitS RA15, RX97, RA64 is c_is16=1 & CUnitS & j10=0 & j3=1 & j2=0 & j1=1 & c_br=0 & j11=0 & c_sat=0 & RA15 & RX97 & RA64 { RA64 = RA15 + RX97; }
:SUB^CUnitS RA15, RX97, RA64 is c_is16=1 & CUnitS & j10=0 & j3=1 & j2=0 & j1=1 & c_br=0 & j11=1 & c_sat=0 & RA15 & RX97 & RA64 { RA64 = RA15 - RX97; }
:SADD^CUnitS RA15, RX97, RA64 is c_is16=1 & CUnitS & j10=0 & j3=1 & j2=0 & j1=1 & c_br=0 & j11=0 & c_sat=1 & RA15 & RX97 & RA64 { c6000_sem_sadd32(RA15, RX97, RA64); }
:SUB^CUnitS RA15, RX97, RA64 is c_is16=1 & CUnitS & j10=0 & j3=1 & j2=0 & j1=1 & c_br=0 & j11=1 & c_sat=1 & RA15 & RX97 & RA64 { RA64 = RA15 - RX97; }

# ---------------------------------------------------------------------------
# Figure F-23. S3i - SPRUFE8B appendix F.4.  cst3 translates to ucst5 per
# the figure table (000 -> 16, 111 -> 8).
# ---------------------------------------------------------------------------

:SHL^CUnitS RX97, CimmS3i, RA64 is c_is16=1 & CUnitS & j10=1 & j3=1 & j2=0 & j1=1 & c_br=0 & j11=0 & CimmS3i & RX97 & RA64 { RA64 = RX97 << CimmS3i; }
:SHR^CUnitS RX97, CimmS3i, RA64 is c_is16=1 & CUnitS & j10=1 & j3=1 & j2=0 & j1=1 & c_br=0 & j11=1 & CimmS3i & RX97 & RA64 { RA64 = RX97 s>> CimmS3i; }

# ---------------------------------------------------------------------------
# Figure F-24. Smvk8 - SPRUFE8B appendix F.4.
# ---------------------------------------------------------------------------

:MVK^CUnitS Cucst8f24, RA97 is c_is16=1 & CUnitS & j4=1 & j3=0 & j2=0 & j1=1 & Cucst8f24 & RA97 { RA97 = Cucst8f24; }

# ---------------------------------------------------------------------------
# Figure F-25. Ssh5 - SPRUFE8B appendix F.4.  Only SHRU is changed
# into SSHL by the SAT header bit (figure opcode table).
# ---------------------------------------------------------------------------

:SHL^CUnitS RA97, Cucst5f23, RB97 is c_is16=1 & CUnitS & j10=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=0 & j5=0 & RA97 & Cucst5f23 & RB97 { RB97 = RA97 << Cucst5f23; }
:SHR^CUnitS RA97, Cucst5f23, RB97 is c_is16=1 & CUnitS & j10=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=0 & j5=1 & RA97 & Cucst5f23 & RB97 { RB97 = RA97 s>> Cucst5f23; }
:SHRU^CUnitS RA97, Cucst5f23, RB97 is c_is16=1 & CUnitS & j10=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=1 & j5=0 & RA97 & Cucst5f23 & RB97 & c_sat=0 { RB97 = RA97 >> Cucst5f23; }
:SSHL^CUnitS RA97, Cucst5f23, RB97 is c_is16=1 & CUnitS & j10=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=1 & j5=0 & RA97 & Cucst5f23 & RB97 & c_sat=1 { c6000_sem_sshl32(RA97, Cucst5f23, RB97); }

# ---------------------------------------------------------------------------
# Figure F-26. S2sh - SPRUFE8B appendix F.4.  x = 0: src and dst are on the
# same side.  The opcode selects SSHL independently of the SAT header bit.
# ---------------------------------------------------------------------------

:SHL^CUnitS RA97, RA15, RB97 is c_is16=1 & CUnitS & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=0 & j11=0 & RA97 & RA15 & RB97 { RB97 = RA97 << (RA15 & 63); }
:SHR^CUnitS RA97, RA15, RB97 is c_is16=1 & CUnitS & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=0 & j11=1 & RA97 & RA15 & RB97 { RB97 = RA97 s>> (RA15 & 63); }
:SHRU^CUnitS RA97, RA15, RB97 is c_is16=1 & CUnitS & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=1 & j11=0 & RA97 & RA15 & RB97 { RB97 = RA97 >> (RA15 & 63); }
:SSHL^CUnitS RA97, RA15, RB97 is c_is16=1 & CUnitS & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=1 & j11=1 & RA97 & RA15 & RB97 { c6000_sem_sshl32(RA97, RA15, RB97); }

# ---------------------------------------------------------------------------
# Figure F-27. Sc5 - SPRUFE8B appendix F.4.  op = 11 selects S2ext
# (Figure F-28).  SET/CLR take csta = cstb = ucst5, i.e. a single bit.
# ---------------------------------------------------------------------------

:EXTU^CUnitS RA97, Cucst5f23, 31, CAcc is c_is16=1 & CUnitS & j10=0 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=0 & j5=0 & RA97 & Cucst5f23 & CAcc { CAcc = (RA97 << Cucst5f23) >> 31; }
:SET^CUnitS RA97, Cucst5d, Cucst5f23, RB97 is c_is16=1 & CUnitS & j10=0 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=0 & j5=1 & RA97 & Cucst5d & Cucst5f23 & RB97 { local b = 1; b = b << Cucst5d; RB97 = RA97 | b; }
:CLR^CUnitS RA97, Cucst5d, Cucst5f23, RB97 is c_is16=1 & CUnitS & j10=0 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j6=1 & j5=0 & RA97 & Cucst5d & Cucst5f23 & RB97 { local b = 1; b = b << Cucst5d; RB97 = RA97 & ~b; }

# ---------------------------------------------------------------------------
# Figure F-28. S2ext - SPRUFE8B appendix F.4.
# ---------------------------------------------------------------------------

:EXT^CUnitS RA97, 16, 16, RA15 is c_is16=1 & CUnitS & j10=0 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=0 & j11=0 & RA97 & RA15 { RA15 = (RA97 << 16) s>> 16; }
:EXT^CUnitS RA97, 24, 24, RA15 is c_is16=1 & CUnitS & j10=0 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=0 & j11=1 & RA97 & RA15 { RA15 = (RA97 << 24) s>> 24; }
:EXTU^CUnitS RA97, 16, 16, RA15 is c_is16=1 & CUnitS & j10=0 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=1 & j11=0 & RA97 & RA15 { RA15 = (RA97 << 16) >> 16; }
:EXTU^CUnitS RA97, 24, 24, RA15 is c_is16=1 & CUnitS & j10=0 & j6=1 & j5=1 & j4=0 & j3=0 & j2=0 & j1=1 & c_br=0 & j12=1 & j11=1 & RA97 & RA15 { RA15 = (RA97 << 24) >> 24; }

# ---------------------------------------------------------------------------
# Figure F-29. Sx2op - SPRUFE8B appendix F.4.  src1 = dst.
# ---------------------------------------------------------------------------

:ADD^CUnitS RA15, RX97, RB15 is c_is16=1 & CUnitS & j10=0 & j6=0 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & c_br=0 & j11=0 & RA15 & RX97 & RB15 { RB15 = RA15 + RX97; }
:SUB^CUnitS RA15, RX97, RB15 is c_is16=1 & CUnitS & j10=0 & j6=0 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & c_br=0 & j11=1 & RA15 & RX97 & RB15 { RB15 = RA15 - RX97; }

# ---------------------------------------------------------------------------
# Figure F-30. Sx5 (ADDK) - SPRUFE8B appendix F.4.
# This opcode also has no branch-form collision when header BR is set.
# ---------------------------------------------------------------------------

:ADDK^CUnitS Cucst5d, RA97 is c_is16=1 & CUnitS & j10=1 & j6=0 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & Cucst5d & RA97 { RA97 = RA97 + Cucst5d; }

# ---------------------------------------------------------------------------
# Figure F-31. Sx1 - SPRUFE8B appendix F.4.  op = 100 is reserved;
# op = 000/001/101/111 are LSDx1 (Figure G-4); op = 110 is MVC src, ILC
# and is only defined for s = 1.  The MVC sub-opcode does not overlap
# a branch form, so it is valid with either compact-header BR value.
# ---------------------------------------------------------------------------

:SUB^CUnitS^" 0, "^RA97^", "^RB97 is c_is16=1 & CUnitS & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & c_br=0 & j15=0 & j14=1 & j13=0 & RA97 & RB97 { RB97 = 0 - RA97; }
:ADD^CUnitS^" -1, "^RA97^", "^RB97 is c_is16=1 & CUnitS & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & c_br=0 & j15=0 & j14=1 & j13=1 & RA97 & RB97 { RB97 = RA97 - 1; }
:MVC^CUnitS RA97^", ILC" is c_is16=1 & CUnitS & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & j15=1 & j14=1 & j13=0 & q_s=1 & RA97 { ILC = RA97; }

# ---------------------------------------------------------------------------
# Figure F-32. Sx1b (BNOP register form) - SPRUFE8B appendix F.4.  src2 is
# a 4-bit register from B0-B15 (figure note).  The opcode space is unique
# to this form, so it is decoded regardless of the header BR bit.
# ---------------------------------------------------------------------------

:BNOP^CUnitS RB710, CN3 is c_is16=1 & CUnitS & j12=0 & j11=0 & j6=1 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & RB710 & CN3 { goto [RB710]; }

# ---------------------------------------------------------------------------
# Figures G-1/G-2. LSDmvto / LSDmvfr - SPRUFE8B appendix G.3.  The srcms /
# dstms fields are not defined by Table G-1 and are not used by the
# mnemonic, so they are left unconstrained here.
# ---------------------------------------------------------------------------

:MV^CUnitLSD RX97, RA15 is c_is16=1 & CUnitLSD & j6=0 & j5=0 & j2=1 & j1=1 & RX97 & RA15 { RA15 = RX97; }
:MV^CUnitLSD RX97, RA15 is c_is16=1 & CUnitLSD & j6=1 & j5=0 & j2=1 & j1=1 & RX97 & RA15 { RA15 = RX97; }

# ---------------------------------------------------------------------------
# Figure G-3. LSDx1c - SPRUFE8B appendix G.3.  Predicated MVK with a
# 1-bit constant; CC selects [A0], [!A0], [B0] or [!B0].
# ---------------------------------------------------------------------------

:CPredCC^"MVK"^CUnitLSD " " Cucst1f^", "^RA97 is c_is16=1 & CPredCC & CUnitLSD & j12=0 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=0 & j14=0 & Cucst1f & RA97 { if (A0 != 0) goto <cskip>; RA97 = Cucst1f; <cskip> }
:CPredCC^"MVK"^CUnitLSD " " Cucst1f^", "^RA97 is c_is16=1 & CPredCC & CUnitLSD & j12=0 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=0 & j14=1 & Cucst1f & RA97 { if (A0 == 0) goto <cskip>; RA97 = Cucst1f; <cskip> }
:CPredCC^"MVK"^CUnitLSD " " Cucst1f^", "^RA97 is c_is16=1 & CPredCC & CUnitLSD & j12=0 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=1 & j14=0 & Cucst1f & RA97 { if (B0 != 0) goto <cskip>; RA97 = Cucst1f; <cskip> }
:CPredCC^"MVK"^CUnitLSD " " Cucst1f^", "^RA97 is c_is16=1 & CPredCC & CUnitLSD & j12=0 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=1 & j14=1 & Cucst1f & RA97 { if (B0 == 0) goto <cskip>; RA97 = Cucst1f; <cskip> }

# ---------------------------------------------------------------------------
# Figure G-4. LSDx1 - SPRUFE8B appendix G.3.  op = 010/011/100/110 defer
# to the per-unit Figures C-20 (.D), D-11 (.L) and F-31 (.S); only the
# unit-independent operations are constructed here.
# ---------------------------------------------------------------------------

:MVK^CUnitLSD^" 0, "^RA97 is c_is16=1 & CUnitLSD & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=0 & j14=0 & j13=0 & RA97 { RA97 = 0; }
:MVK^CUnitLSD^" 1, "^RA97 is c_is16=1 & CUnitLSD & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=0 & j14=0 & j13=1 & RA97 { RA97 = 1; }
:ADD^CUnitLSD^" 1, "^RB97 is c_is16=1 & CUnitLSD & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=1 & j14=0 & j13=1 & RA97 & RB97 { RB97 = RA97 + 1; }
:XOR^CUnitLSD^" 1, "^RB97 is c_is16=1 & CUnitLSD & j12=1 & j11=1 & j10=0 & j6=1 & j5=1 & j2=1 & j1=1 & j15=1 & j14=1 & j13=1 & RA97 & RB97 { RB97 = RA97 ^ 1; }

# ---------------------------------------------------------------------------
# Figures H-5/H-6. Uspl / Uspldr (SPLOOP / SPLOOPD) - appendix H.4.
# Cii displays the actual initiation interval, one more than the field.
# ---------------------------------------------------------------------------

:SPLOOP Cii is c_is16=1 & j15=0 & j13=0 & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j0=0 & Cii { c6000_sploop(Cii, 0:4); if (ILC == 0) goto <done>; ILC = ILC - 1; <done> }
:SPLOOPD Cii is c_is16=1 & j15=0 & j13=0 & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j0=1 & Cii { c6000_sploopd(Cii, 0:4); }
:"[A0]"^"SPLOOPD" Cii is c_is16=1 & j15=1 & j13=0 & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j0=0 & Cii { c6000_sploopd(Cii, 12:4); }
:"[B0]"^"SPLOOPD" Cii is c_is16=1 & j15=1 & j13=0 & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & j0=1 & Cii { c6000_sploopd(Cii, 2:4); }

# ---------------------------------------------------------------------------
# Figure H-7. Uspk (SPKERNEL) - SPRUFE8B appendix H.4.
# ---------------------------------------------------------------------------

:SPKERNEL Cspk is c_is16=1 & j13=0 & j12=1 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & Cspk { c6000_spkernel(Cspk); }

# ---------------------------------------------------------------------------
# Figure H-8. Uspm (SPMASK / SPMASKR) - SPRUFE8B appendix H.4.  The
# unitmask bit order is not given by the figure; D2 D1 S2 S1 L2 L1 are
# placed in bits 5..0 in that order.
# ---------------------------------------------------------------------------

:SPMASK Cmask is c_is16=1 & j13=1 & j12=0 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & Cmask { c6000_spmask(Cmask); }
:SPMASKR Cmask is c_is16=1 & j13=1 & j12=1 & j11=1 & j10=1 & j6=1 & j5=1 & j4=0 & j3=0 & j2=1 & j1=1 & Cmask { c6000_spmaskr(Cmask, ILC, RILC); }

# ---------------------------------------------------------------------------
# Figure H-9. Unop (NOP) - SPRUFE8B appendix H.4.  A NOP has no
# architectural effect.
# ---------------------------------------------------------------------------

:NOP CN3 is c_is16=1 & j12=0 & j11=1 & j10=1 & j9=0 & j8=0 & j7=0 & j6=1 & j5=1 & j4=0 & j3=1 & j2=1 & j1=1 & j0=0 & CN3 {  }

