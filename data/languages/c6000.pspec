<!-- TMS320C6000 processor specification. -->
<processor_spec>
  <programcounter register="PC"/>
  <properties>
    <property key="c6000.packetSize" value="32"/>
    <property key="c6000.delaySlotsBranch" value="5"/>
    <property key="c6000.delaySlotsLoad" value="4"/>
  </properties>
</processor_spec>
