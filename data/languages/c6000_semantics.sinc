#  Hand-written p-code semantics for the C6000 instructions that are modelled.
#
#  Apache-2.0.  Every macro below is traceable to the "Execution" block of the
#  matching instruction description in TI SPRUFE8B; the section is named in
#  the comment above each group.
#
#  tools/gen_decode.py scans this file for `# SEM: MNEMONIC` markers and emits
#  a call to `c6000_sem_<mnemonic>(<operands>)` for those instructions.  The
#  argument order is the operand order of the generated constructor, which
#  follows the manual's syntax line.

# ---------------------------------------------------------------------------
# Integer arithmetic and logic - SPRUFE8B section 3.12, ADD/SUB/AND/OR/XOR/
# ANDN/ADDU.
# ---------------------------------------------------------------------------

# SEM: ADD
macro c6000_sem_add(a, b, d) { d = a + b; }
# SEM: ADDU
macro c6000_sem_addu(a, b, d) { d = a + b; }
# SEM: SUB
macro c6000_sem_sub(a, b, d) { d = a - b; }
# Packed arithmetic and comparisons (SPRUFE8B ADD2, ADD4, SUB2, SUB4,
# CMPEQ2, CMPEQ4, CMPGT2, CMPGTU4). Each lane wraps independently;
# comparison results are collected in the low two or four bits.
# SEM: ADD2
macro c6000_sem_add2(a, b, d) {
  local lo:4 = ((a & 0xffff) + (b & 0xffff)) & 0xffff;
  local hi:4 = ((a >> 16) + (b >> 16)) & 0xffff;
  d = lo | (hi << 16);
}
# SEM: ADD4
macro c6000_sem_add4(a, b, d) {
  local b0:4 = ((a & 0xff) + (b & 0xff)) & 0xff;
  local b1:4 = (((a >> 8) & 0xff) + ((b >> 8) & 0xff)) & 0xff;
  local b2:4 = (((a >> 16) & 0xff) + ((b >> 16) & 0xff)) & 0xff;
  local b3:4 = ((a >> 24) + (b >> 24)) & 0xff;
  d = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
# SEM: SUB2
macro c6000_sem_sub2(a, b, d) {
  local lo:4 = ((a & 0xffff) - (b & 0xffff)) & 0xffff;
  local hi:4 = ((a >> 16) - (b >> 16)) & 0xffff;
  d = lo | (hi << 16);
}
# SEM: SUB4
macro c6000_sem_sub4(a, b, d) {
  local b0:4 = ((a & 0xff) - (b & 0xff)) & 0xff;
  local b1:4 = (((a >> 8) & 0xff) - ((b >> 8) & 0xff)) & 0xff;
  local b2:4 = (((a >> 16) & 0xff) - ((b >> 16) & 0xff)) & 0xff;
  local b3:4 = ((a >> 24) - (b >> 24)) & 0xff;
  d = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
# SEM: CMPEQ2
macro c6000_sem_cmpeq2(a, b, d) {
  local lo:4 = zext((a & 0xffff) == (b & 0xffff));
  local hi:4 = zext((a >> 16) == (b >> 16));
  d = lo | (hi << 1);
}
# SEM: CMPEQ4
macro c6000_sem_cmpeq4(a, b, d) {
  local c0:4 = zext((a & 0xff) == (b & 0xff));
  local c1:4 = zext(((a >> 8) & 0xff) == ((b >> 8) & 0xff));
  local c2:4 = zext(((a >> 16) & 0xff) == ((b >> 16) & 0xff));
  local c3:4 = zext((a >> 24) == (b >> 24));
  d = c0 | (c1 << 1) | (c2 << 2) | (c3 << 3);
}
# SEM: CMPGT2
macro c6000_sem_cmpgt2(a, b, d) {
  local al:4 = (a << 16) s>> 16;
  local bl:4 = (b << 16) s>> 16;
  local ah:4 = a s>> 16;
  local bh:4 = b s>> 16;
  local lo:4 = zext(al s> bl);
  local hi:4 = zext(ah s> bh);
  d = lo | (hi << 1);
}
# SEM: CMPGTU4
macro c6000_sem_cmpgtu4(a, b, d) {
  local c0:4 = zext((a & 0xff) > (b & 0xff));
  local c1:4 = zext(((a >> 8) & 0xff) > ((b >> 8) & 0xff));
  local c2:4 = zext(((a >> 16) & 0xff) > ((b >> 16) & 0xff));
  local c3:4 = zext((a >> 24) > (b >> 24));
  d = c0 | (c1 << 1) | (c2 << 2) | (c3 << 3);
}
# Packed extrema (SPRUFE8B MIN2, MAX2, MINU4, MAXU4). Sign-extend only
# the signed halfword comparisons; preserve the original lane bits.
# SEM: MIN2
macro c6000_sem_min2(a, b, d) {
  local al:4 = (a << 16) s>> 16;
  local bl:4 = (b << 16) s>> 16;
  local ah:4 = a s>> 16;
  local bh:4 = b s>> 16;
  local ml:4 = 0 - zext(al s< bl);
  local mh:4 = 0 - zext(ah s< bh);
  local lo:4 = ((a & ml) | (b & ~ml)) & 0xffff;
  local hi:4 = (((a >> 16) & mh) | ((b >> 16) & ~mh)) & 0xffff;
  d = lo | (hi << 16);
}
# SEM: MAX2
macro c6000_sem_max2(a, b, d) {
  local al:4 = (a << 16) s>> 16;
  local bl:4 = (b << 16) s>> 16;
  local ah:4 = a s>> 16;
  local bh:4 = b s>> 16;
  local ml:4 = 0 - zext(al s> bl);
  local mh:4 = 0 - zext(ah s> bh);
  local lo:4 = ((a & ml) | (b & ~ml)) & 0xffff;
  local hi:4 = (((a >> 16) & mh) | ((b >> 16) & ~mh)) & 0xffff;
  d = lo | (hi << 16);
}
# SEM: MINU4
macro c6000_sem_minu4(a, b, d) {
  local m0:4 = 0 - zext((a & 0xff) < (b & 0xff));
  local m1:4 = 0 - zext(((a >> 8) & 0xff) < ((b >> 8) & 0xff));
  local m2:4 = 0 - zext(((a >> 16) & 0xff) < ((b >> 16) & 0xff));
  local m3:4 = 0 - zext((a >> 24) < (b >> 24));
  local r0:4 = ((a & m0) | (b & ~m0)) & 0xff;
  local r1:4 = (((a >> 8) & m1) | ((b >> 8) & ~m1)) & 0xff;
  local r2:4 = (((a >> 16) & m2) | ((b >> 16) & ~m2)) & 0xff;
  local r3:4 = (((a >> 24) & m3) | ((b >> 24) & ~m3)) & 0xff;
  d = r0 | (r1 << 8) | (r2 << 16) | (r3 << 24);
}
# SEM: MAXU4
macro c6000_sem_maxu4(a, b, d) {
  local m0:4 = 0 - zext((a & 0xff) > (b & 0xff));
  local m1:4 = 0 - zext(((a >> 8) & 0xff) > ((b >> 8) & 0xff));
  local m2:4 = 0 - zext(((a >> 16) & 0xff) > ((b >> 16) & 0xff));
  local m3:4 = 0 - zext((a >> 24) > (b >> 24));
  local r0:4 = ((a & m0) | (b & ~m0)) & 0xff;
  local r1:4 = (((a >> 8) & m1) | ((b >> 8) & ~m1)) & 0xff;
  local r2:4 = (((a >> 16) & m2) | ((b >> 16) & ~m2)) & 0xff;
  local r3:4 = (((a >> 24) & m3) | ((b >> 24) & ~m3)) & 0xff;
  d = r0 | (r1 << 8) | (r2 << 16) | (r3 << 24);
}
# Rounded averages (SPRUFE8B AVG2 and AVGU4). Perform the extra-bit
# addition before shifting so an input pair at its maximum cannot wrap.
# SEM: AVG2
macro c6000_sem_avg2(a, b, d) {
  local al:4 = (a << 16) s>> 16;
  local bl:4 = (b << 16) s>> 16;
  local ah:4 = a s>> 16;
  local bh:4 = b s>> 16;
  local lo:4 = ((al + bl + 1) s>> 1) & 0xffff;
  local hi:4 = ((ah + bh + 1) s>> 1) & 0xffff;
  d = lo | (hi << 16);
}
# SEM: AVGU4
macro c6000_sem_avgu4(a, b, d) {
  local b0:4 = ((a & 0xff) + (b & 0xff) + 1) >> 1;
  local b1:4 = (((a >> 8) & 0xff) + ((b >> 8) & 0xff) + 1) >> 1;
  local b2:4 = (((a >> 16) & 0xff) + ((b >> 16) & 0xff) + 1) >> 1;
  local b3:4 = ((a >> 24) + (b >> 24) + 1) >> 1;
  d = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
# SEM: SUBU
macro c6000_sem_subu(a, b, d) {
  local lhs:8 = zext(a);
  local rhs:8 = zext(b);
  # The long register stores a zero-extended signed 40-bit result.
  d = (lhs - rhs) & 0xffffffffff;
}
# SEM: NORM
macro c6000_sem_norm32(a, d) {
  # Count redundant sign bits, excluding the sign bit itself.
  if (a s< 0) goto <negative>;
  d = lzcount(a) - 1;
  goto <done>;
  <negative> d = lzcount(~a) - 1;
  <done>
}
macro c6000_sem_norm40(a, d) {
  # A C6000 long occupies a register pair but is 40 bits wide.  Mask the
  # unused upper 24 bits before counting.  Count the high eight and low 32
  # bits separately: some p-code interpreters cap lzcount at its 32-bit
  # result width even when the input has 64 bits.
  local bits:8 = a & 0xffffffffff;
  if ((bits & 0x8000000000) == 0) goto <positive>;
  bits = (~bits) & 0xffffffffff;
  <positive>
  local upper:8 = bits >> 32;
  local hi:4 = upper:4;
  local lo:4 = bits:4;
  if (hi == 0) goto <low>;
  d = lzcount(hi) - 25;
  goto <done>;
  <low> d = lzcount(lo) + 7;
  <done>
}

# Compact saturating arithmetic (SPRUFE8B Figures D-4, E-5, F-22, F-25,
# F-26).  P-code records the final CSR.SAT value; the CPU's one-cycle-later
# flag write belongs to the execute-packet/pipeline model.
# SEM: SADD
macro c6000_sem_sadd32(a, b, d) {
  local x:8 = sext(a);
  local y:8 = sext(b);
  local result:8 = x + y;
  if (result s> 0x7fffffff) goto <positive>;
  if (result s< -0x80000000) goto <negative>;
  d = result:4;
  goto <done>;
  <positive> d = 0x7fffffff;
  CSR = CSR | 0x200;
  goto <done>;
  <negative> d = 0x80000000;
  CSR = CSR | 0x200;
  <done>
}
# SEM: SSUB
macro c6000_sem_ssub32(a, b, d) {
  local x:8 = sext(a);
  local y:8 = sext(b);
  local result:8 = x - y;
  if (result s> 0x7fffffff) goto <positive>;
  if (result s< -0x80000000) goto <negative>;
  d = result:4;
  goto <done>;
  <positive> d = 0x7fffffff;
  CSR = CSR | 0x200;
  goto <done>;
  <negative> d = 0x80000000;
  CSR = CSR | 0x200;
  <done>
}
macro c6000_sem_sadd40(a, b, d) {
  local lhs:8 = sext(a);
  local rhs:8 = (b << 24) s>> 24;
  local result:8 = lhs + rhs;
  if (result s> 0x7fffffffff) goto <positive>;
  if (result s< -0x8000000000) goto <negative>;
  d = result & 0xffffffffff;
  goto <done>;
  <positive> d = 0x7fffffffff;
  CSR = CSR | 0x200;
  goto <done>;
  <negative> d = 0x8000000000;
  CSR = CSR | 0x200;
  <done>
}
macro c6000_sem_ssub40(a, b, d) {
  local lhs:8 = sext(a);
  local rhs:8 = (b << 24) s>> 24;
  local result:8 = lhs - rhs;
  if (result s> 0x7fffffffff) goto <positive>;
  if (result s< -0x8000000000) goto <negative>;
  d = result & 0xffffffffff;
  goto <done>;
  <positive> d = 0x7fffffffff;
  CSR = CSR | 0x200;
  goto <done>;
  <negative> d = 0x8000000000;
  CSR = CSR | 0x200;
  <done>
}
macro c6000_sem_smpy16(a, b, d) {
  local product:4 = a * b;
  local shifted:4 = product << 1;
  if (shifted == 0x80000000) goto <sat>;
  d = shifted;
  goto <done>;
  <sat> d = 0x7fffffff;
  CSR = CSR | 0x200;
  <done>
}
# SEM: SMPYH
macro c6000_sem_smpyh(a, b, d) {
  local x:4 = a s>> 16;
  local y:4 = b s>> 16;
  local shifted:4 = (x * y) << 1;
  if (shifted == 0x80000000) goto <sat>;
  d = shifted;
  goto <done>;
  <sat> d = 0x7fffffff;
  CSR = CSR | 0x200;
  <done>
}
macro c6000_sem_sshl32(v, c, d) {
  local count:4 = c & 63;
  if (count > 31) goto <large>;
  local wide:8 = sext(v);
  wide = wide << count;
  if (wide s> 0x7fffffff) goto <positive>;
  if (wide s< -0x80000000) goto <negative>;
  d = wide:4;
  goto <done>;
  <large> if (v s> 0) goto <positive>;
  if (v s< 0) goto <negative>;
  d = 0;
  goto <done>;
  <positive> d = 0x7fffffff;
  CSR = CSR | 0x200;
  goto <done>;
  <negative> d = 0x80000000;
  CSR = CSR | 0x200;
  <done>
}
# SEM: AND
macro c6000_sem_and(a, b, d) { d = a & b; }
# SEM: OR
macro c6000_sem_or(a, b, d) { d = a | b; }
# SEM: XOR
macro c6000_sem_xor(a, b, d) { d = a ^ b; }
# SEM: ANDN
macro c6000_sem_andn(a, b, d) { d = a & (~b); }

# SEM: NOT
macro c6000_sem_not(a, d) { d = ~a; }
# SEM: NEG
macro c6000_sem_neg(a, d) { d = -a; }
# SEM: ABS
macro c6000_sem_abs(a, d) { local s = (a s< 0); if (s) goto <neg>; d = a; goto <end>; <neg> d = -a; <end> }

# SEM: MV
macro c6000_sem_mv(a, d) { d = a; }
# SEM: MVD
macro c6000_sem_mvd(a, d) { d = a; }
# SEM: ZERO
macro c6000_sem_zero(d) { d = 0; }

# ---------------------------------------------------------------------------
# Immediates - SPRUFE8B section 3.12, ADDK / MVK / MVKL / MVKH / ADDKPC.
#
# MVKH writes the high half; MVK/MVKL write the low half.  ADDKPC adds a
# 7-bit signed constant, shifted left by two, to PCE1 (the address of the
# first instruction of the containing fetch packet).
# ---------------------------------------------------------------------------

# SEM: ADDK
macro c6000_sem_addk(v, d) { d = d + ((v << 16) s>> 16); }
# SEM: MVK
macro c6000_sem_mvk5(v, d) { d = (v << 27) s>> 27; }
macro c6000_sem_mvk16(v, d) { d = (v << 16) s>> 16; }
# SEM: MVKL
macro c6000_sem_mvkl(v, d) { d = (v << 16) s>> 16; }
# SEM: MVKH
macro c6000_sem_mvkh(v, d) { d = (d & 0xffff) | (zext(v) << 16); }
# SEM: ADDKPC
macro c6000_sem_addkpc(v, d, n) { d = (inst_start & 0xffffffe0) + (v << 2); }

# .D-unit address arithmetic in linear mode - SPRUFE8B section 3.9.3 and
# the ADDAB/ADDAH/ADDAW/ADDAD and SUBAB/SUBAH/SUBAW execution blocks.
# Circular AMR addressing for A4-A7/B4-B7 is not yet modelled.
# SEM: ADDAB
macro c6000_sem_addab(b, a, d) { d = b + a; }
# SEM: ADDAH
macro c6000_sem_addah(b, a, d) { d = b + (a << 1); }
# SEM: ADDAW
macro c6000_sem_addaw(b, a, d) { d = b + (a << 2); }
# SEM: ADDAD
macro c6000_sem_addad(b, a, d) { d = b + (a << 3); }
# SEM: SUBAB
macro c6000_sem_subab(b, a, d) { d = b - a; }
# SEM: SUBAH
macro c6000_sem_subah(b, a, d) { d = b - (a << 1); }
# SEM: SUBAW
macro c6000_sem_subaw(b, a, d) { d = b - (a << 2); }

# SEM: SUBC
macro c6000_sem_subc(a, b, d) {
  if (a < b) goto <less>;
  d = ((a - b) << 1) + 1;
  goto <done>;
  <less> d = a << 1;
  <done>
}
# SEM: ROTL
macro c6000_sem_rotl(v, n, d) {
  local count:4 = n & 31;
  d = (v << count) | (v >> ((32 - count) & 31));
}
# SEM: LMBD
macro c6000_sem_lmbd(bit, v, d) {
  if ((bit & 1) == 0) goto <zeros>;
  d = lzcount(v);
  goto <done>;
  <zeros> d = lzcount(~v);
  <done>
}

# 16x16 integer multiplies and MPYLI - SPRUFE8B MPY, MPYU, MPYSU,
# MPYUS and MPYLI execution blocks.  Signed five-bit constants are decoded
# by SCst5 before reaching these macros.
# SEM: MPY
macro c6000_sem_mpy(a, b, d) {
  local x:4 = (a << 16) s>> 16;
  local y:4 = (b << 16) s>> 16;
  d = x * y;
}
# SEM: MPYU
macro c6000_sem_mpyu(a, b, d) { d = (a & 0xffff) * (b & 0xffff); }
# SEM: MPYSU
macro c6000_sem_mpysu(a, b, d) {
  local x:4 = (a << 16) s>> 16;
  d = x * (b & 0xffff);
}
# SEM: MPYUS
macro c6000_sem_mpyus(a, b, d) {
  local y:4 = (b << 16) s>> 16;
  d = (a & 0xffff) * y;
}
# SEM: MPYLI
macro c6000_sem_mpyli(a, b, d) {
  local x:4 = (a << 16) s>> 16;
  local x64:8 = sext(x);
  local y64:8 = sext(b);
  d = x64 * y64;
}
# SEM: MPYID
macro c6000_sem_mpyid(a, b, d) {
  local x:8 = sext(a);
  local y:8 = sext(b);
  d = x * y;
}
# SEM: MPYLHU
macro c6000_sem_mpylhu(a, b, d) { d = (a & 0xffff) * (b >> 16); }
# SEM: MPYHL
macro c6000_sem_mpyhl(a, b, d) {
  local y:4 = (b << 16) s>> 16;
  d = (a s>> 16) * y;
}
# SEM: MPYHLU
macro c6000_sem_mpyhlu(a, b, d) { d = (a >> 16) * (b & 0xffff); }
# SEM: MPYLH
macro c6000_sem_mpylh(a, b, d) {
  local x:4 = (a << 16) s>> 16;
  d = x * (b s>> 16);
}
# SEM: MPY32
macro c6000_sem_mpy32_32(a, b, d) { d = a * b; }
macro c6000_sem_mpy32_64(a, b, d) {
  local x:8 = sext(a);
  local y:8 = sext(b);
  d = x * y;
}
# SEM: MPY32U
macro c6000_sem_mpy32u(a, b, d) {
  local x:8 = zext(a);
  local y:8 = zext(b);
  d = x * y;
}
# SEM: MPY32SU
macro c6000_sem_mpy32su(a, b, d) {
  local x:8 = sext(a);
  local y:8 = zext(b);
  d = x * y;
}
# SEM: MPY32US
macro c6000_sem_mpy32us(a, b, d) {
  local x:8 = zext(a);
  local y:8 = sext(b);
  d = x * y;
}
# SEM: MPYI
macro c6000_sem_mpyi(a, b, d) { d = a * b; }
# SEM: PACK2
macro c6000_sem_pack2(a, b, d) { d = ((a & 0xffff) << 16) | (b & 0xffff); }
# SEM: PACKL4
macro c6000_sem_packl4(a, b, d) {
  d = ((a & 0x00ff0000) << 8) | ((a & 0xff) << 16) |
      ((b & 0x00ff0000) >> 8) | (b & 0xff);
}

# ---------------------------------------------------------------------------
# Bit-field operations - SPRUFE8B CLR, EXT, EXTU and SET descriptions.
# The register forms pack csta in src1[9:5] and cstb in src1[4:0].
# The manual declares register-form results invalid when src1[31:10] != 0;
# p-code uses the specified low ten bits in that case.
# ---------------------------------------------------------------------------

# SEM: CLR
macro c6000_sem_clr(s, a, b, d) {
  if (b < a) goto <copy>;
  local mask:4 = (0xffffffff >> (31 - (b - a))) << a;
  d = s & (~mask);
  goto <done>;
  <copy> d = s;
  <done>
}
macro c6000_sem_clr_r(s, v, d) {
  local a:4 = (v >> 5) & 31;
  local b:4 = v & 31;
  c6000_sem_clr(s, a, b, d);
}

# SEM: EXT
macro c6000_sem_ext(s, a, b, d) { d = (s << a) s>> b; }
macro c6000_sem_ext_r(s, v, d) {
  local a:4 = (v >> 5) & 31;
  local b:4 = v & 31;
  c6000_sem_ext(s, a, b, d);
}

# SEM: EXTU
macro c6000_sem_extu(s, a, b, d) { d = (s << a) >> b; }
macro c6000_sem_extu_r(s, v, d) {
  local a:4 = (v >> 5) & 31;
  local b:4 = v & 31;
  c6000_sem_extu(s, a, b, d);
}

# SEM: SET
macro c6000_sem_set(s, a, b, d) {
  if (b < a) goto <copy>;
  local mask:4 = (0xffffffff >> (31 - (b - a))) << a;
  d = s | mask;
  goto <done>;
  <copy> d = s;
  <done>
}
macro c6000_sem_set_r(s, v, d) {
  local a:4 = (v >> 5) & 31;
  local b:4 = v & 31;
  c6000_sem_set(s, a, b, d);
}

# ---------------------------------------------------------------------------
# Single-precision floating point and integer conversions - SPRUFE8B
# section 3.12. These operate on one 32-bit register per operand. Double-
# precision instructions use register pairs and remain explicit placeholders.
# ---------------------------------------------------------------------------

# SEM: ABSSP
macro c6000_sem_abssp(a, d) { d = abs(a); }
# SEM: ADDSP
macro c6000_sem_addsp(a, b, d) { d = a f+ b; }
# SEM: ADDDP
macro c6000_sem_adddp(a, b, d) { d = a f+ b; }
# SEM: SUBDP
macro c6000_sem_subdp(a, b, d) { d = a f- b; }
# SEM: SUBSP
macro c6000_sem_subsp(a, b, d) { d = a f- b; }
# SEM: MPYSP
macro c6000_sem_mpysp(a, b, d) { d = a f* b; }
# SEM: MPYDP
macro c6000_sem_mpydp(a, b, d) { d = a f* b; }
# SEM: INTSP
macro c6000_sem_intsp(a, d) { d = int2float(a); }
# SEM: INTSPU
macro c6000_sem_intspu(a, d) { local unsigned:8 = zext(a); d = int2float(unsigned); }
# SEM: INTDP
macro c6000_sem_intdp(a, d) { d = int2float(a); }
# SEM: INTDPU
macro c6000_sem_intdpu(a, d) { local unsigned:8 = zext(a); d = int2float(unsigned); }
# SEM: SPDP
macro c6000_sem_spdp(a, d) { d = float2float(a); }
# SEM: DPSP
macro c6000_sem_dpsp(a, d) { d = float2float(a); }
# The .L1 and .L2 conversion units use separate FADCR halves.  RMODE is at
# bits 10:9/26:25; source flags are in the corresponding low/high half.
# SPRUFE8B sections 2.10.1 and 3.12, SPINT/SPTRUNC execution blocks.
# SEM: SPINT
# SEM: SPTRUNC
macro c6000_sem_sp_to_int(a, d, side, forceTrunc) {
  local sideShift:4 = side;
  local forced:4 = forceTrunc;
  local raw:4 = a;
  local sign:4 = raw >> 31;
  local exponent:4 = (raw >> 23) & 0xff;
  local fraction:4 = raw & 0x7fffff;
  local flags:4 = 0;
  local roundMode:4 = (FADCR >> (9 + sideShift)) & 3;
  if (forced == 0) goto <modeReady>;
  roundMode = 1;
  <modeReady>

  if (exponent == 255) goto <special>;
  if (exponent != 0) goto <normal>;
  if (fraction != 0) goto <denormal>;
  <normal>
  if (exponent > 158) goto <overflow>;
  if (exponent != 158) goto <rounding>;
  if (sign == 0) goto <overflow>;
  if (fraction != 0) goto <overflow>;
  <rounding>

  local rounded:4 = a;
  if (roundMode == 0) goto <nearest>;
  if (roundMode == 1) goto <zero>;
  if (roundMode == 2) goto <up>;
  rounded = floor(a);
  goto <convert>;
  <nearest>
  # SLEIGH's FLOAT_ROUND rounds halfway cases away from zero.  The C6000
  # RMODE=0 rule is ties-to-even, so correct even-integer halfway cases.
  rounded = round(a);
  local truncatedInt:4 = trunc(a);
  if ((truncatedInt & 1) != 0) goto <convert>;
  local truncatedFloat:4 = int2float(truncatedInt);
  local delta:4 = a f- truncatedFloat;
  local half:4 = 0x3f000000;
  local absDelta:4 = abs(delta);
  if (absDelta f!= half) goto <convert>;
  rounded = truncatedFloat;
  goto <convert>;
  <zero> goto <convert>;
  <up> rounded = ceil(a);
  <convert> d = trunc(rounded);
  local back:4 = int2float(d);
  if (back f== a) goto <done>;
  flags = 0x80;
  goto <done>;

  <special>
  if (fraction == 0) goto <overflow>;
  flags = 0x12; # NAN2 | INVAL
  goto <saturate>;
  <overflow> flags = 0xc0; # INEX | OVER
  <saturate>
  if (sign == 0) goto <positive>;
  d = 0x80000000;
  goto <done>;
  <positive> d = 0x7fffffff;
  goto <done>;

  <denormal>
  d = 0;
  flags = 0x88; # INEX | DEN2
  <done>
  FADCR = FADCR | (flags << sideShift);
}
# SEM: DPINT
# SEM: DPTRUNC
macro c6000_sem_dp_to_int(a, d, side, forceTrunc) {
  local sideShift:4 = side;
  local forced:4 = forceTrunc;
  local raw:8 = a;
  local signWide:8 = raw >> 63;
  local sign:4 = signWide:4;
  local exponent:8 = (raw >> 52) & 0x7ff;
  local fraction:8 = raw & 0xfffffffffffff;
  local flags:4 = 0;
  local roundMode:4 = (FADCR >> (9 + sideShift)) & 3;
  if (forced == 0) goto <modeReady>;
  roundMode = 1;
  <modeReady>

  if (exponent == 2047) goto <special>;
  if (exponent != 0) goto <normal>;
  if (fraction != 0) goto <denormal>;
  <normal>
  if (exponent > 1054) goto <overflow>;
  if (exponent != 1054) goto <rounding>;
  if (sign == 0) goto <overflow>;
  if (fraction != 0) goto <overflow>;
  <rounding>

  local rounded:8 = a;
  if (roundMode == 0) goto <nearest>;
  if (roundMode == 1) goto <zero>;
  if (roundMode == 2) goto <up>;
  rounded = floor(a);
  goto <convert>;
  <nearest>
  rounded = round(a);
  local truncatedInt:4 = trunc(a);
  if ((truncatedInt & 1) != 0) goto <convert>;
  local truncatedFloat:8 = int2float(truncatedInt);
  local delta:8 = a f- truncatedFloat;
  local half:8 = 0x3fe0000000000000;
  local absDelta:8 = abs(delta);
  if (absDelta f!= half) goto <convert>;
  rounded = truncatedFloat;
  goto <convert>;
  <zero> goto <convert>;
  <up> rounded = ceil(a);
  <convert> d = trunc(rounded);
  local back:8 = int2float(d);
  if (back f== a) goto <done>;
  flags = 0x80;
  goto <done>;

  <special>
  if (fraction == 0) goto <overflow>;
  flags = 0x12; # NAN2 | INVAL
  goto <saturate>;
  <overflow> flags = 0xc0; # INEX | OVER
  <saturate>
  if (sign == 0) goto <positive>;
  d = 0x80000000;
  goto <done>;
  <positive> d = 0x7fffffff;
  goto <done>;

  <denormal>
  d = 0;
  flags = 0x88; # INEX | DEN2
  <done>
  FADCR = FADCR | (flags << sideShift);
}
# SEM: CMPEQSP
macro c6000_sem_cmpeqsp(a, b, d) { d = zext(a f== b); }
# SEM: CMPEQDP
macro c6000_sem_cmpeqdp(a, b, d) { d = zext(a f== b); }
# SEM: CMPGTSP
macro c6000_sem_cmpgtsp(a, b, d) { d = zext(a f> b); }
# SEM: CMPGTDP
macro c6000_sem_cmpgtdp(a, b, d) { d = zext(a f> b); }
# SEM: CMPLTSP
macro c6000_sem_cmpltsp(a, b, d) { d = zext(a f< b); }
# SEM: CMPLTDP
macro c6000_sem_cmpltdp(a, b, d) { d = zext(a f< b); }

# ---------------------------------------------------------------------------
# Shifts - SPRUFE8B section 3.12, SHL / SHR / SHRU / SSHL.
# ---------------------------------------------------------------------------

# SEM: SHL
macro c6000_sem_shl(v, c, d) { d = v << c; }
# SEM: SHR
macro c6000_sem_shr(v, c, d) { d = v s>> c; }
# SEM: SHRU
macro c6000_sem_shru(v, c, d) { d = v >> c; }
# SEM: SHR2
macro c6000_sem_shr2(v, c, d) {
  local count:4 = c & 31;
  if (count < 16) goto <shift>;
  count = 15;
  <shift>
  local low:4 = ((v << 16) s>> 16) s>> count;
  local high:4 = (v s>> 16) s>> count;
  d = (low & 0xffff) | ((high & 0xffff) << 16);
}
# SEM: SHRU2
macro c6000_sem_shru2(v, c, d) {
  local count:4 = c & 31;
  if (count < 16) goto <shift>;
  d = 0;
  goto <done>;
  <shift>
  local low:4 = (v & 0xffff) >> count;
  local high:4 = (v >> 16) >> count;
  d = low | (high << 16);
  <done>
}
macro c6000_sem_satleft32(v, count, d) {
  local result:8 = sext(v) << count;
  if (result s> 0x7fffffff) goto <positive>;
  if (result s< -0x80000000) goto <negative>;
  d = result:4;
  goto <done>;
  <positive> d = 0x7fffffff;
  CSR = CSR | 0x200;
  goto <done>;
  <negative> d = 0x80000000;
  CSR = CSR | 0x200;
  <done>
}
# SEM: SSHVL
macro c6000_sem_sshvl(v, c, d) {
  local count:8 = sext(c);
  if (count s< 0) goto <right>;
  if (count s<= 31) goto <left>;
  count = 31;
  <left> c6000_sem_satleft32(v, count, d);
  goto <done>;
  <right> count = -count;
  if (count <= 31) goto <rightshift>;
  count = 31;
  <rightshift> d = v s>> count;
  <done>
}
# SEM: SSHVR
macro c6000_sem_sshvr(v, c, d) {
  local count:8 = sext(c);
  if (count s< 0) goto <left>;
  if (count s<= 31) goto <right>;
  count = 31;
  <right> d = v s>> count;
  goto <done>;
  <left> count = -count;
  if (count <= 31) goto <leftshift>;
  count = 31;
  <leftshift> c6000_sem_satleft32(v, count, d);
  <done>
}
# SEM: SSHL
macro c6000_sem_sshl(v, c, d) { local neg = (c s< 0); if (neg) goto <r>; d = v << c; goto <e>; <r> d = v s>> (-c); <e> }

# ---------------------------------------------------------------------------
# Comparisons - SPRUFE8B section 3.12, CMPEQ / CMPLT / CMPGT / CMPLTU /
# CMPGTU.  These write 0 or 1.
# ---------------------------------------------------------------------------

# SEM: CMPEQ
macro c6000_sem_cmpeq(a, b, d) { local t = (a == b); if (t) goto <y>; d = 0; goto <e>; <y> d = 1; <e> }
# SEM: CMPLT
macro c6000_sem_cmplt(a, b, d) { local t = (a s< b); if (t) goto <y>; d = 0; goto <e>; <y> d = 1; <e> }
# SEM: CMPGT
macro c6000_sem_cmpgt(a, b, d) { local t = (a s> b); if (t) goto <y>; d = 0; goto <e>; <y> d = 1; <e> }
# SEM: CMPLTU
macro c6000_sem_cmpltu(a, b, d) { local t = (a < b); if (t) goto <y>; d = 0; goto <e>; <y> d = 1; <e> }
# SEM: CMPGTU
macro c6000_sem_cmpgtu(a, b, d) { local t = (a > b); if (t) goto <y>; d = 0; goto <e>; <y> d = 1; <e> }

# ---------------------------------------------------------------------------
# Loads and stores - SPRUFE8B section 3.12 and Table 3-11.  The memory
# operand in the decode table evaluates to the effective address, so the
# access size and sign extension are applied here.
# ---------------------------------------------------------------------------

# SEM: LDW
macro c6000_sem_ldw(a, d) { d = *[ram]:4 a; }
# SEM: LDDW
macro c6000_sem_lddw(a, d) { d = *[ram]:8 a; }
# SEM: LDNDW
macro c6000_sem_ldndw(a, d) { d = *[ram]:8 a; }
# SEM: LDNW
macro c6000_sem_ldnw(a, d) { d = *[ram]:4 a; }
# SEM: LDB
macro c6000_sem_ldb(a, d) { d = sext(*[ram]:1 a); }
# SEM: LDBU
macro c6000_sem_ldbu(a, d) { d = zext(*[ram]:1 a); }
# SEM: LDH
macro c6000_sem_ldh(a, d) { d = sext(*[ram]:2 a); }
# SEM: LDHU
macro c6000_sem_ldhu(a, d) { d = zext(*[ram]:2 a); }

# SEM: STW
macro c6000_sem_stw(s, a) { *[ram]:4 a = s; }
# SEM: STDW
macro c6000_sem_stdw(s, a) { *[ram]:8 a = s; }
# SEM: STNDW
macro c6000_sem_stndw(s, a) { *[ram]:8 a = s; }
# SEM: STNW
macro c6000_sem_stnw(s, a) { *[ram]:4 a = s; }
# SEM: STB
macro c6000_sem_stb(s, a) { *[ram]:1 a = s; }
# SEM: STH
macro c6000_sem_sth(s, a) { *[ram]:2 a = s; }

# ---------------------------------------------------------------------------
# Branches - SPRUFE8B section 3.12, B / CALLP, and section 3.4 for the delay
# slots.  The target operand already carries the PCE1-relative address (see
# the BranchTarget / BnopTgt tables in c6000.sinc and c6000_manual.sinc).
#
# C6000 branches have five delay slots, so the return address a CALLP leaves
# in A3/B3 is the instruction after the five delay slots: inst_start + 4 + 20.
# ---------------------------------------------------------------------------

# SEM: B
macro c6000_sem_b(t) { goto t; }
# SEM: CALLP
macro c6000_sem_callp(t) { B3 = inst_start + 24; call t; }

# Indirect branches through a register (B .S2 src2, B IRP, B NRP).
macro c6000_sem_b_ind(t) { goto [t]; }

# ---------------------------------------------------------------------------
# Miscellaneous - SPRUFE8B section 3.12.
# ---------------------------------------------------------------------------

# SEM: NOP
macro c6000_sem_nop(n) { }
# SEM: IDLE
macro c6000_sem_idle() { }
# SEM: DINT
macro c6000_sem_dint() { }
# SEM: RINT
macro c6000_sem_rint() { }
